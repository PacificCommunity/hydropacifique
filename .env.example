# Copy to .env and fill in real values before deploying:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored — never commit real credentials.

# --- Database -----------------------------------------------------------------
# Generate with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=spc_pass
MYSQL_DATABASE=hp-data-fj
# The application connects as this user, not as root.
MYSQL_USER=hydro
MYSQL_PASSWORD=psc16789

# --- Public URLs --------------------------------------------------------------
# Must match how users actually reach the site (the app builds absolute links
# and redirects from these). Keep the trailing slash.
# Local:  http://127.0.0.1:8080/
# Server: https://hydro.example.org/
HP_HTTP_SERVER=http://127.0.0.1:8080/
HP_HTTPS_SERVER=http://127.0.0.1:8080/

# --- Host port binding --------------------------------------------------------
WEB_PORT=8080
# Set to 127.0.0.1 when a reverse proxy terminates TLS in front of this stack,
# so the container is not exposed directly to the internet.
WEB_BIND=0.0.0.0
